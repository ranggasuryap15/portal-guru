# ==============================================================================
# Tujuan: Template konfigurasi environment untuk deployment dan developer baru.
# Dipakai Oleh: Developer/CI-CD untuk membuat .env
# Dependensi: Service db (MySQL 8.0), web (Nginx 8002), app (PHP-FPM)
# Fungsi Utama: Template referensi variabel konfigurasi aplikasi dan docker
# Side Effect: Tidak ada langsung (template file)
# ==============================================================================

APP_NAME="Portal Guru"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_PORT=8002
DB_PORT_FORWARD=3307
PMA_PORT=8082

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# Database Configuration (Docker MySQL)
# ==============================================================================
# Koneksi internal Laravel di dalam Docker container (sesuai service 'db' di docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portal_guru
DB_USERNAME=portal_guru
DB_PASSWORD=secret

# Kredensial root MySQL (digunakan saat inisialisasi container DB & maintenance)
DB_ROOT_PASSWORD=root

# Port Forwarding untuk akses database dari luar Docker (DBeaver, TablePlus, GUI client host: 127.0.0.1:3307)
# DB_PORT_FORWARD=3307 (didefinisikan di bagian atas file)


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
